pkgbase = hyprdial
	pkgdesc = Settings app for Hyprland, with Omarchy integration (GTK4 + libadwaita)
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/mvp-mark/hyprdial
	arch = any
	license = MIT
	makedepends = gettext
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	optdepends = libnm: saves Wi-Fi passwords from the Connectivity page
	optdepends = impala: Wi-Fi manager opened by the Connectivity page
	optdepends = bluetui: Bluetooth manager opened by the Connectivity page
	optdepends = wiremix: audio mixer opened by the Sound page
	optdepends = waybar: the bar on plain Hyprland, an alternative to the Omarchy shell bar on Omarchy
	optdepends = hypridle: lock, screen off and suspend when idle on plain Hyprland
	optdepends = hyprlock: the lock screen on plain Hyprland
	optdepends = hyprpaper: the wallpaper on plain Hyprland
	optdepends = brightnessctl: dims the screen before locking on plain Hyprland
	provides = omarchy-settings-gui
	conflicts = omarchy-settings-gui
	replaces = omarchy-settings-gui
	source = hyprdial-1.1.0.tar.gz::https://github.com/mvp-mark/hyprdial/archive/refs/tags/v1.1.0.tar.gz
	sha256sums = 77c373ba7b98dbfe78575b80647063c7c631ea5efc2640d8ec1885336f9b6117

pkgname = hyprdial
