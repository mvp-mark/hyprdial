# Maintainer: Marcus Vinícius Peixoto Paulo <mvp.paulo@gmail.com>
# Dependencies follow hyprdial/deps.py (tests/test_pkgbuild.py checks it):
# required -> depends (gettext only compiles the translations -> makedepends), optional -> optdepends.
# Never call it omarchy-settings: that is a package in Omarchy's own repository, which omarchy depends on.
pkgname=hyprdial
pkgver=1.0.0
pkgrel=1
pkgdesc="Settings app for Hyprland, with Omarchy integration (GTK4 + libadwaita)"
arch=('any')
url="https://github.com/mvp-mark/$pkgname"
license=('MIT')
# omarchy-settings-gui: the package's name before 1.0
provides=('omarchy-settings-gui')
conflicts=('omarchy-settings-gui')
replaces=('omarchy-settings-gui')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita')
makedepends=('gettext')
optdepends=('libnm: saves Wi-Fi passwords from the Connectivity page'
            'impala: Wi-Fi manager opened by the Connectivity page'
            'bluetui: Bluetooth manager opened by the Connectivity page'
            'wiremix: audio mixer opened by the Sound page'
            'waybar: the bar on plain Hyprland, an alternative to the Omarchy shell bar on Omarchy'
            'hypridle: lock, screen off and suspend when idle on plain Hyprland'
            'hyprlock: the lock screen on plain Hyprland'
            'hyprpaper: the wallpaper on plain Hyprland'
            'brightnessctl: dims the screen before locking on plain Hyprland')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# pinned by build-release.sh when the release is made
sha256sums=('77c373ba7b98dbfe78575b80647063c7c631ea5efc2640d8ec1885336f9b6117')

build() {
  cd "$pkgname-$pkgver"
  for po in po/*.po; do
    lang=$(basename "$po" .po)
    mkdir -p "hyprdial/locale/$lang/LC_MESSAGES"
    msgfmt -o "hyprdial/locale/$lang/LC_MESSAGES/$pkgname.mo" "$po"
  done
  # pt_PT and other variants without their own catalog use Brazilian Portuguese
  mkdir -p hyprdial/locale/pt/LC_MESSAGES
  cp hyprdial/locale/pt_BR/LC_MESSAGES/$pkgname.mo hyprdial/locale/pt/LC_MESSAGES/
}

package() {
  cd "$pkgname-$pkgver"
  local app="/usr/share/$pkgname"
  install -d "$pkgdir$app"
  cp -r hyprdial "$pkgdir$app/"
  find "$pkgdir$app" -name __pycache__ -type d -prune -exec rm -rf {} +
  python -m compileall -q -s "$pkgdir" -p / "$pkgdir$app"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec env PYTHONPATH=%s python3 -m hyprdial "$@"\n' "$app" > "$pkgdir/usr/bin/$pkgname"
  chmod 755 "$pkgdir/usr/bin/$pkgname"
  ln -s $pkgname "$pkgdir/usr/bin/omarchy-settings"  # the command's name before 1.0

  install -Dm644 data/io.github.mvp_mark.Hyprdial.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
